# -----------------------------------------------------------------------------
# Wirddy Supabase & Application Environment Configuration (.env.example)
# Copy this file to .env.local and configure your project credentials.
# NEVER commit real credentials or .env.local to Git!
# -----------------------------------------------------------------------------

# Public Supabase URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Publishable / Anon Key (safe for browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Server-Only Supabase Service Role Key (NEVER expose to browser or NEXT_PUBLIC_!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Canonical Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
